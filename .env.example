# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region drives the S3 endpoint (https://s3.{B2_REGION}.backblazeb2.com).
B2_REGION=us-west-004
# Public base URL for objects (optional — used to build shareable links).
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001-EXAMPLE-not-a-real-key-xxxxxxxx
# B2_BUCKET_NAME=my-transcript-archive
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-transcript-archive.s3.us-west-004.backblazeb2.com

# --- Transcription pipeline (local OSS — no remote inference API) ---
# FREE HuggingFace token, used ONLY to download pyannote's gated diarization
# weights (https://huggingface.co/settings/tokens). Leave empty to run
# transcribe-only (no speaker labels). Never billed, never an inference API.
HF_TOKEN=
# Media prefix the Upload page writes to and the Library is scoped to.
ARCHIVE_MEDIA_PREFIX=media/
# Local ML engine knobs (CPU-friendly defaults; bump for GPU throughput).
WHISPERX_MODEL=base
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_BATCH_SIZE=8
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
